rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Cho phép học sinh và giáo viên đọc và ghi bài nộp thực hành
    match /submissions/{subId} {
      allow read, write: if true;
    }

    // Cho phép đọc và cập nhật danh sách học sinh theo lớp
    match /roster/{studentId} {
      allow read, write: if true;
    }

    // Cho phép đọc và cập nhật cài đặt phòng máy (quyền nộp bài, mã pin...)
    match /app_settings/{settingId} {
      allow read, write: if true;
    }

    // Mặc định cho phép các tài liệu trong cơ sở dữ liệu thực hành
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
